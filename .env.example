# ===== 必填 =====
# 初始管理员账号（仅在数据库无任何账号时自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-at-least-8

# JWT 签名密钥，生产环境必须修改
SECRET_KEY=please-change-this-secret

# ===== 可选 =====

# 站点正式域名（生成 sitemap、canonical、客户访问链接用），默认 https://cooolmake.com
SITE_URL=https://cooolmake.com

# Google Search Console 验证码（用 HTML 标记方式验证时填写；网域+DNS 方式则留空）
GOOGLE_SITE_VERIFICATION=
# 文件存储：local（本地 backend/storage）或 qiniu（七牛云）
STORAGE_BACKEND=local

# 七牛云对象存储（STORAGE_BACKEND=qiniu 时必填）
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=plynook
QINIU_DOMAIN=
QINIU_PREFIX=uploads

# 中文文案自动翻译（MyMemory API，默认开启）
AUTO_TRANSLATE=true

# 首次启动写入演示数据（分类/标签/商品/Banner）
ENABLE_DEMO_SEED=false

# 未被任何商品/报价单/Banner引用的上传文件保留时长（小时），超期自动删除
ORPHAN_GRACE_HOURS=24
